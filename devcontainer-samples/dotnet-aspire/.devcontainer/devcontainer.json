{
    "name": "dotnet-aspire",
    "image": "registry.access.redhat.com/hi/dotnet-sdk:latest-builder",
    "containerUser": "podman",
    "remoteUser": "podman",
    "updateRemoteUserUID": false,
    "runArgs": [
        "--name=${localWorkspaceFolderBasename}-dev",
        "--device=/dev/fuse",
        "--device=/dev/net/tun",
        "--security-opt=seccomp=unconfined"
    ],
    "features": {
        "ghcr.io/jonathan-tyler/containers/podman-in-podman:0": {}
    },
    "remoteEnv": {
        "ASPIRE_CONTAINER_RUNTIME": "podman"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "postCreateCommand": "dotnet dev-certs https && dotnet restore",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp"
            ]
        }
    }
}

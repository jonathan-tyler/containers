        "username": "nonroot"
      }
    }
  },
  "existing-podman": {
    "build": {
      "dockerfile": "podman-in-podman/test/existing-podman/Containerfile"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/podman-in-podman/test",
    "updateRemoteUserUID": false,
    "features": {
      "podman-in-podman": {
        "username": "nonroot"
      }
    }
  },
  "fedora": {
    "build": {
      "dockerfile": "podman-in-podman/test/fedora/Containerfile"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/podman-in-podman/test",
    "updateRemoteUserUID": false,
    "features": {
      "podman-in-podman": {}
    }
  },
  "no-socket-mount": {
    "build": {
      "dockerfile": "podman-in-podman/test/no-socket-mount/Containerfile"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/podman-in-podman/test",
    "updateRemoteUserUID": false,

{
    "name": "dotnet-aspire",
    "image": "registry.access.redhat.com/hi/dotnet-sdk:latest-builder",
    "containerUser": "65532",
    "remoteUser": "65532",
    "updateRemoteUserUID": false,
    "initializeCommand": "chmod -R g+rwX ${localWorkspaceFolder} 2>/dev/null || true; find ${localWorkspaceFolder} -type d -exec chmod g+s {} + 2>/dev/null || true",
    "runArgs": [
        "--name=${localWorkspaceFolderBasename}-dev",
        "--userns=keep-id:uid=65532,gid=0",
        "--group-add=keep-groups",
        "--device=/dev/fuse",
        "--device=/dev/net/tun",
        "--security-opt=seccomp=unconfined"
    ],
    "features": {
        "ghcr.io/jonathan-tyler/containers/podman-in-podman:0": {}
    },
    "remoteEnv": {
        "ASPIRE_CONTAINER_RUNTIME": "podman"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "postCreateCommand": "dotnet dev-certs https && dotnet restore",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp"
            ]
        }
    }
}

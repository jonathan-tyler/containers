FROM registry.access.redhat.com/hi/core-runtime:latest-builder

USER root

RUN dnf -y install --setopt=install_weak_deps=False shadow-utils \
    && dnf clean all \
    && useradd --create-home --home-dir /home/nonroot --shell /bin/bash nonroot \
    && install -d -o nonroot -g nonroot /var/cache/homebrew-shared

COPY devcontainer-features/src/homebrew-packages /tmp/homebrew-packages

RUN PACKAGES="hello jq bat difftastic eza fd fzf git-delta lazygit neovim opencode sesh starship tree-sitter-cli tmux yazi zoxide zsh zsh-vi-mode zsh-autosuggestions" \
        USERNAME=nonroot \
        CACHE_DIRECTORY=/var/cache/homebrew-shared \
        CLEANUP_HOMEBREW=false \
        /bin/sh /tmp/homebrew-packages/install.sh \
    && rm -rf /tmp/homebrew-packages \
    && chown -R root:root /home/linuxbrew/.linuxbrew /var/cache/homebrew-shared \
    && dnf clean all \
    && rm -rf /var/cache/dnf

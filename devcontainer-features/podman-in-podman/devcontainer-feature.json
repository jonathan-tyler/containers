{
  "id": "podman-in-podman",
  "version": "0.1.1",
  "name": "Podman (Podman-in-Podman)",
  "documentationURL": "https://www.redhat.com/en/blog/podman-inside-container",
  "description": "Run Podman inside the dev container with isolated storage volumes and container-friendly Podman defaults.",
  "entrypoint": "/usr/local/share/podman-in-podman-init.sh",
  "containerEnv": {
    "_CONTAINERS_USERNS_CONFIGURED": "",
    "BUILDAH_ISOLATION": "chroot"
  },
  "securityOpt": [
    "label=disable"
  ],
  "mounts": [
    {
      "source": "pinp-var-lib-containers-${devcontainerId}",
      "target": "/var/lib/containers",
      "type": "volume"
    },
    {
      "source": "pinp-podman-home-${devcontainerId}",
      "target": "/home/podman/.local/share/containers",
      "type": "volume"
    }
  ]
}

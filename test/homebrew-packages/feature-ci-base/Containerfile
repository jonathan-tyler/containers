FROM registry.access.redhat.com/hi/core-runtime:latest-builder

USER root

ENV HOMEBREW_CACHE=/var/cache/homebrew-shared

RUN dnf -y install --setopt=install_weak_deps=False ca-certificates file git gzip shadow-utils tar util-linux xz bash curl gawk procps-ng \
    && useradd --create-home --home-dir /home/nonroot --shell /bin/bash nonroot \
    && install -d -o nonroot -g nonroot /home/linuxbrew /var/cache/homebrew-shared

USER nonroot

RUN env HOMEBREW_NO_ASK=1 NONINTERACTIVE=1 CI=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

RUN env \
        HOMEBREW_CACHE=/var/cache/homebrew-shared \
        HOMEBREW_NO_ANALYTICS=1 \
        HOMEBREW_NO_AUTO_UPDATE=1 \
        HOMEBREW_NO_ENV_HINTS=1 \
        HOMEBREW_NO_INSTALL_CLEANUP=1 \
        /home/linuxbrew/.linuxbrew/bin/brew install --formula \
            hello jq bat difftastic eza fd fzf git-delta lazygit neovim opencode sesh starship tree-sitter-cli tmux yazi zoxide zsh zsh-vi-mode zsh-autosuggestions

USER root

RUN chown -R root:root /home/linuxbrew/.linuxbrew /var/cache/homebrew-shared \
    && dnf clean all \
    && rm -rf /var/cache/dnf
